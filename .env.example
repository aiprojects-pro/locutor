# ===== Secretos (OBLIGATORIO cambiarlos en producción) =====
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-aleatoria
# Token para la API máquina-a-máquina (vacío = /api/tts deshabilitado)
API_BEARER_TOKEN=

# ===== Voces sherpa-onnx (multivoz) =====
# Carpeta raíz con los modelos descargados. El catálogo de voces y la voz por
# defecto se definen en config/voices.yaml
MODELS_ROOT=./models
# "cpu" o "coreml"  (¡medir con benchmark, no asumir!)
PROVIDER=cpu

# ===== Concurrencia / rendimiento (M4 Max: ~10 núcleos de rendimiento) =====
NUM_THREADS=4
CONCURRENCY=2
MAX_CONCURRENT_JOBS=2
CHUNK_MAX_CHARS=500
PER_CHUNK_TIMEOUT_S=60

# ===== Límites de entrada =====
MAX_INPUT_CHARS=50000
MAX_UPLOAD_BYTES=20971520
MAX_TOTAL_UPLOAD_BYTES=62914560
MAX_FILES_PER_REQUEST=10

# ===== Audio =====
SILENCE_MS=120
MP3_BITRATE=128k

# ===== Sesión / cookies =====
# En producción con HTTPS debe ser true. Para http local de pruebas: false
COOKIE_SECURE=true
SESSION_MAX_AGE_S=28800

# ===== Red / proxy =====
# true solo si hay un reverse proxy de confianza (Caddy/nginx) delante
TRUST_PROXY=true
# Whitelist de IPs para la API (separadas por coma en JSON). Vacío = desactivada
# API_IP_WHITELIST=["203.0.113.10"]

# ===== Rate limiting =====
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TTS_JOBS_PER_MINUTE=6
