<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd para macOS (p. ej. el Mac Mini M4 de destino).
     Copiar a /Library/LaunchDaemons/com.locutor.app.plist (servicio del sistema).
     Ajusta la ruta /Users/Shared/locutor si instalas en otro sitio.

       sudo cp deploy/com.locutor.app.plist /Library/LaunchDaemons/
       sudo launchctl load -w /Library/LaunchDaemons/com.locutor.app.plist
       sudo launchctl list | grep locutor

     uvicorn lee el .env desde WorkingDirectory (cwd). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.locutor.app</string>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/locutor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/locutor/.venv/bin/uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/locutor/data/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/locutor/data/stderr.log</string>
</dict>
</plist>
