# ===========================================================================
# Plantilla de configuración de PRODUCCIÓN. Copiar como .env en la raíz del
# proyecto y rellenar los secretos. NUNCA subir el .env real a git.
# ===========================================================================

# --- Secretos (OBLIGATORIO) ---
# Genera cada uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=__PEGAR_CLAVE_ALEATORIA_LARGA__
API_BEARER_TOKEN=__PEGAR_TOKEN_ALEATORIO__   # vacío = API /api/tts deshabilitada

# --- Voces ---
MODELS_ROOT=./models
PROVIDER=cpu                 # "cpu" o "coreml" — MEDIR con scripts/bench.py

# --- Concurrencia (ajustar a la CPU del servidor) ---
NUM_THREADS=4
CONCURRENCY=2
MAX_CONCURRENT_JOBS=2

# --- Seguridad (producción detrás de HTTPS/Caddy) ---
COOKIE_SECURE=true           # OBLIGATORIO true bajo HTTPS
TRUST_PROXY=true             # hay un reverse proxy (Caddy) delante
SESSION_MAX_AGE_S=28800

# --- Límites ---
MAX_INPUT_CHARS=50000
MAX_UPLOAD_BYTES=20971520
MAX_TOTAL_UPLOAD_BYTES=62914560
MAX_FILES_PER_REQUEST=10

# --- Rate limiting ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TTS_JOBS_PER_MINUTE=6

# --- (Opcional) restringir la API por IP ---
# API_IP_WHITELIST=["203.0.113.10"]
